{
  "name": "afterlight-lite",
  "version": "0.1.0",
  "private": true,
  "description": "AFTERLIGHT LITE — a simpler, space-faring endless bullet-heaven roguelite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && AFTERLIGHT_LITE_SINGLE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4"
  }
}
