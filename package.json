{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "description": "AFTERLIGHT — an offline single-player bullet-heaven survival roguelite. Hold back the dark.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && AFTERLIGHT_SINGLE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:idle": "vite --config idle-game/vite.config.ts",
    "build:idle": "tsc -p idle-game/tsconfig.json --noEmit && vite build --config idle-game/vite.config.ts",
    "build:idle:single": "tsc -p idle-game/tsconfig.json --noEmit && VANGUARD_SINGLE=1 vite build --config idle-game/vite.config.ts",
    "preview:idle": "vite preview --config idle-game/vite.config.ts",
    "typecheck:idle": "tsc -p idle-game/tsconfig.json --noEmit",
    "test:idle": "vitest run --config idle-game/vitest.config.ts",
    "test:idle:watch": "vitest --config idle-game/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1",
    "three": "^0.185.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4"
  }
}
